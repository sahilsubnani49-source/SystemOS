# ---------------------------------------------------------------
# SystemOS Backend — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.
# ---------------------------------------------------------------

# --- AI Provider Keys (set at least one for cloud mode) ---

# Anthropic Claude (highest priority in cloud mode)
ANTHROPIC_API_KEY=

# OpenAI (used if Anthropic key is not set)
OPENAI_API_KEY=

# Google Gemini (used if neither Anthropic nor OpenAI key is set)
GOOGLE_API_KEY=

# --- Model overrides (optional) ---
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MODEL=gemini-1.5-flash

# --- Local AI (Ollama) ---
# Used when the app's model_preference is set to "local"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
