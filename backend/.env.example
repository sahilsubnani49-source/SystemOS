# ---------------------------------------------------------------
# SystemOS Backend — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to version control.
# ---------------------------------------------------------------

# --- Runtime / deployment (read by app/config.py) ---
# local | production. production refuses to start on SQLite or a missing/weak JWT secret.
APP_ENV=local

# Unset locally -> SQLite at backend/systemos.db.
# Cloud (Cloud Run AND Vercel share one): the Neon POOLED string with the driver prefix:
# postgresql+psycopg://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# 32+ random chars. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the SAME value on Cloud Run and Vercel so tokens work against either host.
JWT_SECRET_KEY=

# Comma-separated. Leave empty for the native mobile app (it sends no Origin header).
CORS_ALLOW_ORIGINS=

# GET /health/llm (a paid provider call, used by Settings diagnostics). On by default; requires a login in production. Set false to 404 it.
EXPOSE_LLM_HEALTH=

# --- AI Provider Keys (set at least one for cloud mode) ---
# Cloud priority: first key present wins, in this order:
#   Groq -> Grok (xAI) -> Gemini -> Anthropic -> OpenAI
# To swap the active provider, just set a different key here.

# Groq / GroqCloud (highest priority — fast open models, generous free tier).
# NOTE: Groq (gsk_... key) is DIFFERENT from Grok / xAI below.
GROQ_API_KEY=

# xAI Grok (used if Groq key is not set)
XAI_API_KEY=

# Google Gemini (used if Grok key is not set)
GOOGLE_API_KEY=

# Anthropic Claude (used if neither Grok nor Gemini key is set)
ANTHROPIC_API_KEY=

# OpenAI (used if none of the above keys are set)
OPENAI_API_KEY=

# --- Model overrides (optional) ---
# Groq retires models fairly often. If you get a 404 model_not_found, list what your
# key can reach: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
XAI_MODEL=grok-2-latest
GOOGLE_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini

# --- Local AI (Ollama) ---
# Used when the app's model_preference is set to "local"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
